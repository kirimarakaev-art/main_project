<!DOCTYPE html>
<html lang="ru" data-bs-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · Справочник по Go</title>
    <script>
      // Тема ставится до отрисовки страницы, чтобы не было белой вспышки
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-bs-theme', theme);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-xl bg-body-tertiary border-bottom sticky-top">
      <div class="container">
        <a class="navbar-brand brand" href="/">
          <span class="brand-mark">Go</span> справочник
        </a>
        <div class="d-flex align-items-center gap-1 order-xl-last">
          <button id="theme-toggle" class="btn btn-link nav-link px-2" type="button" aria-label="Переключить тему" title="Переключить тему">
            <i class="bi bi-moon-stars"></i>
          </button>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Открыть меню">
            <span class="navbar-toggler-icon"></span>
          </button>
        </div>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-xl-0">
            <% if (typeof nav == 'object' && nav) {
                 nav.forEach(function(item) { %>
            <li class="nav-item">
              <a class="nav-link" href="/topics/<%= item.nick %>"><%= item.title %></a>
            </li>
            <%   })
               } %>
          </ul>
          <ul class="navbar-nav mb-2 mb-xl-0">
            <% if (user) { %>
            <li class="nav-item d-flex align-items-center">
              <span class="navbar-text me-2"><i class="bi bi-person-circle"></i> <%= user.username %></span>
              <form action="/logout" method="post">
                <button type="submit" class="btn btn-link nav-link"><i class="bi bi-box-arrow-right"></i> Выйти</button>
              </form>
            </li>
            <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/logreg"><i class="bi bi-box-arrow-in-right"></i> Войти</a>
            </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4 py-lg-5 flex-grow-1">
      <%- body %>
    </main>

    <footer class="border-top py-4 mt-auto">
      <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary">
        <span><span class="brand-mark">Go</span> справочник · учебный проект на Node.js</span>
        <a class="link-secondary" href="https://github.com/kirimarakaev-art/main_project"><i class="bi bi-github"></i> Исходный код</a>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
      (function () {
        var root = document.documentElement;
        var button = document.getElementById('theme-toggle');
        var icon = button.querySelector('i');

        function showIcon() {
          var dark = root.getAttribute('data-bs-theme') === 'dark';
          icon.className = dark ? 'bi bi-sun' : 'bi bi-moon-stars';
          button.title = dark ? 'Включить светлую тему' : 'Включить тёмную тему';
        }

        button.addEventListener('click', function () {
          var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-bs-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          showIcon();
        });

        showIcon();
      })();
    </script>
  </body>
</html>
